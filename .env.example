# Turso Database Configuration
# Remote Turso URL: libsql://[your-database-name]-[your-org].turso.io
# Or local SQLite/libSQL file for development: file:turso_files.db
TURSO_DATABASE_URL=file:turso_files.db

# Turso Authentication Token (generated via `turso db tokens create [db-name]` or Turso dashboard)
# Required for remote Turso databases; optional for local file: databases.
TURSO_AUTH_TOKEN=

# Simple Username & Password Authentication
# Used for the Web UI, REST API, and sync commands.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server Port and Host
PORT=3000
HOST=0.0.0.0
