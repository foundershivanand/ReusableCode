if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Factory Security & Scale CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    score_p = subparsers.add_parser("scorecard", help="Run 14-dimension security scorecard")
    score_p.add_argument("--app", required=True, help="App ID")

    owasp_p = subparsers.add_parser("owasp", help="Run OWASP MASVS & API Security audit")
    owasp_p.add_argument("--app", required=True, help="App ID")

    scale_p = subparsers.add_parser("scale", help="Calculate 1M user scale capacity")
    scale_p.add_argument("--app", required=True, help="App ID")
    scale_p.add_argument("--dau", type=int, default=100000, help="Projected DAU")

    port_p = subparsers.add_parser("portfolio", help="Run central factory security monitor")

    args = parser.parse_args()
    if args.command == "scorecard":
        run_scorecard(args.app)
    elif args.command == "owasp":
        run_owasp_audit(args.app)
    elif args.command == "scale":
        run_scale_calc(args.app, args.dau)
    elif args.command == "portfolio":
        run_portfolio_report()
