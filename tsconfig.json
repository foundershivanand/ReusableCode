{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@auth/*": ["./auth/*"],
      "@billing/*": ["./billing/*"],
      "@tenancy/*": ["./tenancy/*"],
      "@notifications/*": ["./notifications/*"],
      "@settings/*": ["./settings/*"],
      "@admin/*": ["./admin/*"],
      "@storage/*": ["./storage/*"],
      "@analytics/*": ["./analytics/*"],
      "@security/*": ["./security/*"],
      "@ai/*": ["./ai/*"],
      "@onboarding/*": ["./onboarding/*"],
      "@flags/*": ["./flags/*"],
      "@audit/*": ["./audit/*"],
      "@support/*": ["./support/*"],
      "@seo/*": ["./seo/*"],
      "@compliance/*": ["./compliance/*"],
      "@search/*": ["./search/*"],
      "@webhooks/*": ["./webhooks/*"],
      "@portability/*": ["./portability/*"],
      "@referral/*": ["./referral/*"],
      "@metering/*": ["./metering/*"],
      "@i18n/*": ["./i18n/*"],
      "@maintenance/*": ["./maintenance/*"],
      "@changelog/*": ["./changelog/*"],
      "@domains/*": ["./domains/*"],
      "@monitoring/*": ["./monitoring/*"],
      "@deployment/*": ["./deployment/*"],
      "@database/*": ["./database/*"],
      "@experimentation/*": ["./experimentation/*"],
      "@security-center/*": ["./security-center/*"],
      "@core/*": ["./core/*"]
    }
  },
  "include": [
    "core/**/*",
    "auth/**/*",
    "billing/**/*",
    "tenancy/**/*",
    "notifications/**/*",
    "settings/**/*",
    "admin/**/*",
    "storage/**/*",
    "analytics/**/*",
    "security/**/*",
    "ai/**/*",
    "onboarding/**/*",
    "flags/**/*",
    "audit/**/*",
    "support/**/*",
    "seo/**/*",
    "compliance/**/*",
    "search/**/*",
    "webhooks/**/*",
    "portability/**/*",
    "referral/**/*",
    "metering/**/*",
    "i18n/**/*",
    "maintenance/**/*",
    "changelog/**/*",
    "domains/**/*",
    "monitoring/**/*",
    "deployment/**/*",
    "database/**/*",
    "experimentation/**/*",
    "security-center/**/*"
  ]
}
